@{
    ViewData["Title"] = "Trang chu";
}

<div id="noidung">
    <div class="section-head">
        <h3>Vuong Trung Hieu</h3>
    </div>
    <div class="grid">
        @foreach (var t in Model)
        {
            <div class="asset-card">
                <a href="#"><img src="~/images/@t.Anh" alt="@t.TenTs" /></a>
                <h2>@t.TenTs</h2>
                <div class="asset-foot">
                    <span class="price">@(t.NguyenGia?.ToString("0")) tr</span>
                    <button class="btn-buy">Chi tiet</button>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts{
    <script>
        $(".loai").click(function (e){
            e.preventDefault();
            $("#noidung").load("/Home/TaiSanTheoLoai/"+$(this).data("id"));
            $(".menu li").removeClass("active");
            $("this").parent().AddClass("active");
        });
    </script>
}